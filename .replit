modules = ["nodejs-20"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Taafe Vision App"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Taafe Vision App"

[[workflows.workflow]]
name = "Taafe Vision App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -lc 'set -e; PORT=8080 pnpm --filter @workspace/api-server run dev & api_pid=$!; PORT=20053 BASE_PATH=/ pnpm --filter @workspace/taafe-vision run dev & web_pid=$!; cleanup() { kill $api_pid $web_pid 2>/dev/null || true; wait $api_pid $web_pid 2>/dev/null || true; }; trap cleanup EXIT INT TERM; wait -n $api_pid $web_pid'"
waitForPort = 20053

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["android-tools", "gradle", "jdk17", "sdkmanager"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 20053
externalPort = 3000

[[ports]]
localPort = 23072
externalPort = 3001
